# ---------------------------------------------------------------------------
# Annapurna Kitchen - Backend Environment
# ---------------------------------------------------------------------------

FLASK_ENV=development
HOST=0.0.0.0
PORT=5000

# Secrets
SECRET_KEY=dev-only-secret-4f2a9c1e7b
JWT_SECRET_KEY=dev-only-secret-4f2a9c1e7b-too

# ---------------------------------------------------------------------------
# DATABASE - MYSQL
# ---------------------------------------------------------------------------

DB_ENGINE=mysql

# --- local server ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=annapurna_kitchen
MYSQL_USER=root
MYSQL_PASSWORD=123456

# --- hosted server (Aiven / RDS / PlanetScale) ---
# MYSQL_HOST=<service>.<project>.aivencloud.com
# MYSQL_PORT=20934
# MYSQL_DB=defaultdb
# MYSQL_USER=avnadmin
# MYSQL_PASSWORD=<from the provider console>

# TLS, mirroring the mysql client's --ssl-mode. Defaults to DISABLED for a
# local host and REQUIRED for anything else, so a hosted database works with
# no extra setting. VERIFY_CA / VERIFY_IDENTITY additionally validate the
# server certificate and need MYSQL_SSL_CA.
# MYSQL_SSL_MODE=REQUIRED
# MYSQL_SSL_CA=certs/aiven-ca.pem

# DATABASE_URL overrides every MYSQL_* value above. Remember to percent-encode
# a password containing @ : / or ? before putting it in a URI.
# DATABASE_URL=mysql+pymysql://user:pass@host:3306/db?charset=utf8mb4

# SQLite is NOT used
# DB_ENGINE=sqlite
# SQLITE_PATH=instance/annapurna.db

# ---------------------------------------------------------------------------
# SESSION / JWT
# ---------------------------------------------------------------------------

JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7
SESSION_IDLE_MINUTES=30

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# BUSINESS DEFAULTS
# ---------------------------------------------------------------------------

DEFAULT_GST_RATE=5.00
DEFAULT_TAX_MODE=exclusive

# ---------------------------------------------------------------------------
# BACKUP
# ---------------------------------------------------------------------------

BACKUP_ENABLED=true
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=14
BACKUP_HOUR=23
BACKUP_MINUTE=45
MYSQLDUMP_PATH=mysqldump

# ---------------------------------------------------------------------------
# SEED ACCOUNTS
# ---------------------------------------------------------------------------

SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin@12345

SEED_CASHIER_USERNAME=cashier
SEED_CASHIER_PASSWORD=Cashier@12345