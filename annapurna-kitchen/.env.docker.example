# ---------------------------------------------------------------------------
# docker compose environment. Copy to .env before `docker compose up`.
# ---------------------------------------------------------------------------
FLASK_ENV=production

# Generate real values:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-string
JWT_SECRET_KEY=replace-with-a-different-long-random-string

MYSQL_ROOT_PASSWORD=123456
MYSQL_DB=annapurna_kitchen
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_PORT=3306

WEB_PORT=8080
CORS_ORIGINS=http://localhost:8080
SESSION_IDLE_MINUTES=30

# Initial accounts created once by `flask seed`. Change them before go-live.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin@12345
SEED_CASHIER_USERNAME=cashier
SEED_CASHIER_PASSWORD=Cashier@12345
