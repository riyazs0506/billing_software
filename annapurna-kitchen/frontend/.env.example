# Base URL of the Flask API.
# Leave as /api in development to use the Vite proxy defined in vite.config.js.
VITE_API_BASE_URL=/api

# Production example:
# VITE_API_BASE_URL=https://api.annapurnakitchen.in/api

# Optional: where the Vite dev proxy forwards /api
VITE_PROXY_TARGET=http://127.0.0.1:5000

# Printing --------------------------------------------------------------
# browser | qz | webusb | bluetooth
VITE_DEFAULT_PRINT_MODE=browser
# QZ Tray websocket host used by the qz transport
VITE_QZ_HOST=localhost:8181
# Thermal paper width in mm (58 or 80)
VITE_PAPER_WIDTH=80

# App metadata ----------------------------------------------------------
VITE_APP_NAME=Annapurna Kitchen
